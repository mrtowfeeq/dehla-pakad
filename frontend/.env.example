# Dehla Pakad frontend (React / CRACO). Copy to frontend/.env.development (local) or frontend/.env
# (production build) and fill in. Values are baked into the build at build time.

# Where the FastAPI backend is reachable from the browser (no trailing slash). The app calls
# $REACT_APP_BACKEND_URL/api/... and opens its WebSocket at ws(s)://.../api/ws.
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional: expose dev-server health endpoints (local tooling only).
# ENABLE_HEALTH_CHECK=true
