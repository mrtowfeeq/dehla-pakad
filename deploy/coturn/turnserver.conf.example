# /etc/turnserver.conf  — TURN relay for Dehla Pakad voice chat (coturn).
# Players behind strict NATs or on mobile data need a relay; STUN alone often fails there.
# The backend issues short-lived credentials from the same shared secret (VOICE_TURN_SHARED_SECRET).
#
# coturn does not support comments after a value: keep every setting on a plain `name=value` line and put
# comments on their own lines (a trailing comment would become part of the value, e.g. of the secret).

listening-port=3478
tls-listening-port=5349
# The VPS public IPv4 (if the host is behind NAT: external-ip=PUBLIC/PRIVATE)
external-ip=VPS_PUBLIC_IP
realm=dehlapakad.tech

# Same value as VOICE_TURN_SHARED_SECRET in backend.env (a long random string, no spaces):
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET

# TLS for turns: copies of the site certificate readable by the turnserver user, refreshed by
# /etc/letsencrypt/renewal-hooks/deploy/coturn.sh (deploy/coturn/certbot-deploy-hook.sh).
cert=/etc/turnserver/certs/fullchain.pem
pkey=/etc/turnserver/certs/privkey.pem
no-tlsv1
no-tlsv1_1

# Relay ports (open these UDP ports in the firewall)
min-port=49160
max-port=49200

# Limits: allocations per user and in total, and relay bandwidth per session (bytes/s; voice needs ~10 KB/s)
user-quota=12
total-quota=400
max-bps=64000

fingerprint
no-cli
no-multicast-peers

# Never relay to this machine, private networks, link-local / cloud-metadata or other special ranges.
# (no-loopback-peers is the default in current coturn; the 127/8 and ::1 rules below make it explicit.)
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255
# This server's own public addresses (fill in; delete the IPv6 line if the VPS has no IPv6), so the relay
# cannot reach services listening on them:
denied-peer-ip=VPS_PUBLIC_IP
denied-peer-ip=VPS_PUBLIC_IPV6
denied-peer-ip=::
denied-peer-ip=::1
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=100::-100::ffff:ffff:ffff:ffff
denied-peer-ip=2001::-2001:1ff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=2001:db8::-2001:db8:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=2002::-2002:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

log-file=/var/log/turnserver/turn.log
simple-log

# backend.env then gets, for example:
#   VOICE_TURN_URLS=turn:dehlapakad.tech:3478?transport=udp,turn:dehlapakad.tech:3478?transport=tcp,turns:dehlapakad.tech:5349?transport=tcp
#   VOICE_TURN_SHARED_SECRET=<the same secret>
#   VOICE_TURN_CREDENTIAL_TTL_SECONDS=600
