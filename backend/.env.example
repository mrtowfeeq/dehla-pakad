# Dehla Pakad backend (FastAPI) — copy to backend/.env and fill in. Never commit the real .env.

# MongoDB Atlas (or any MongoDB) connection and database name.
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dehla_pakad

# Clerk keys from your own Clerk dashboard. pk_live_/sk_live_ keys make the backend use the "live" data
# scope; pk_test_/sk_test_ keys use the "preview" scope.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# The email that becomes the first admin.
ADMIN_EMAIL=you@example.com

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Optional: reverse-proxy addresses whose X-Forwarded-For header is trusted (comma-separated CIDRs),
# e.g. the Nginx host on the VPS.
TRUSTED_PROXY_CIDRS=

# Optional: spectators per game (default 100).
SPECTATOR_LIMIT=100

# Optional voice chat (WebRTC). STUN defaults to Google's public server; TURN is only needed for
# players behind strict NATs and uses your own TURN server (e.g. coturn) with a shared secret.
VOICE_MAX_PARTICIPANTS=6
VOICE_STUN_URLS=stun:stun.l.google.com:19302
VOICE_TURN_URLS=
VOICE_TURN_SHARED_SECRET=
VOICE_TURN_CREDENTIAL_TTL_SECONDS=600
